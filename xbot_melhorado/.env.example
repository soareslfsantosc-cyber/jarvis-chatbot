# XBot — exemplo de configuração.
# Copie este arquivo para ".env" (na mesma pasta do app.py) e ajuste.
# O arquivo ".env" NÃO deve ir para o Git nem para o zip: ele guarda segredos.
# Variáveis de ambiente reais têm prioridade sobre o que estiver aqui.

# ---------------------------------------------------------------------------
# OBRIGATÓRIO em produção (o padrão). Gere uma chave aleatória com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
XBOT_SECRET_KEY=

# production (padrão) | development
# development liga o recarregamento automático e o modo debug (só em 127.0.0.1)
# e, sem XBOT_SECRET_KEY, usa uma chave temporária.
XBOT_ENV=production

# Onde o servidor escuta. O padrão (127.0.0.1) só aceita conexões deste computador.
# Para testar do celular na mesma rede use 0.0.0.0 — só em rede de confiança, e
# lembre que o servidor embutido do Flask não é feito para ficar exposto.
# XBOT_HOST=127.0.0.1
# XBOT_PORT=5000

# Origens (sites) autorizadas a chamar a API de OUTRO endereço. Vazio = só o próprio
# site do XBot. Nunca use "*": o XBot usa cookies de sessão.
# XBOT_ALLOWED_ORIGINS=https://meusite.com,http://localhost:5173

# Banco SQLite (padrão: xbot.db ao lado do app.py)
# XBOT_DB_PATH=C:\caminho\para\xbot.db

# ---- Limites (valores padrão mostrados) ------------------------------------
# XBOT_GUEST_SECONDS=600               # teste do visitante: 10 minutos
# XBOT_GUEST_COOLDOWN_SECONDS=86400    # depois de esgotado, só volta após 24 h
# XBOT_GUEST_MAX_SESSIONS=1            # janelas de teste por IP+navegador (aumente p/ demos em sala)
# XBOT_LOGIN_MAX_FAILURES_EMAIL=5
# XBOT_LOGIN_MAX_FAILURES_IP=20
# XBOT_LOGIN_WINDOW_SECONDS=900
# XBOT_REGISTER_MAX_PER_HOUR=10

# Atrás de proxy reverso (nginx, Render, Railway...): quantos proxies confiar.
# XBOT_TRUSTED_PROXIES=1

# Rotas de diagnóstico (/db_status, /estatisticas, /raciocinio_debug):
# abertas só em development; nos demais modos exigem login. 1 = abrir.
# XBOT_DIAGNOSTICS=0
